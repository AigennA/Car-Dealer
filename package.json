{
  "name": "car-dealer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "predev": "node scripts/clean-lock.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:test": "cross-env LOCAL_BUILD=1 next build",
    "test:e2e": "playwright test",
    "lighthouse": "npx -y @lhci/cli@0.15.1 autorun",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:test && npm run test:e2e",
    "seed:export": "node --experimental-strip-types scripts/export-seed.mjs"
  },
  "dependencies": {
    "next": "^16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "pngjs": "^7.0.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "compression": "^1.8.2",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
