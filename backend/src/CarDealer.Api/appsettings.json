{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=cardealer.db"
  },
  "Jwt": {
    "Issuer": "car-dealer-api",
    "Audience": "car-dealer-web",
    "Key": "",
    "LifetimeMinutes": 120,
    "ClockSkewSeconds": 60
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://aigenna.github.io",
      "http://localhost:3000"
    ]
  },
  "RateLimits": {
    "FormsPerMinute": 5,
    "LoginPerMinute": 10
  },
  "IdentityPolicy": {
    "RequiredPasswordLength": 12,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "ApiDocs": {
    "Enabled": false,
    "Title": "Car Dealer API"
  },
  "DataFiles": {
    "Workshop": "Data/workshop.json",
    "SeedCars": "Data/seed-cars.json",
    "Business": "Data/business.json"
  }
}
